# Copy this file to .env and paste the OpenRouter key you created.
# Never commit .env or expose this key in browser/client-side code.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Uses an available free model. Set qwen/qwen3-8b after adding OpenRouter credits
# if you specifically need Qwen; individual :free model slugs can disappear.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional metadata sent with requests to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=listing-scraper

# Optional free persistence using a MongoDB Atlas Free cluster.
# Replace the placeholders with the database user and cluster shown by Atlas.
# MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=property_vessel
# Set true online if the app must refuse to start without MongoDB.
# MONGODB_REQUIRED=false

# Required when the app is reachable outside localhost. The browser will show
# its native username/password prompt and keeps all API/download routes private.
# APP_USERNAME=admin
# APP_PASSWORD=replace-with-a-long-random-password
# MAX_ACTIVE_JOBS=1

# Optional. When both OpenRouter and Gemini keys exist, OpenRouter is the
# default. Set this explicitly to "gemini" only when you intend to use it.
# AI_PROVIDER=openrouter
# GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=set-a-model-available-to-your-account
